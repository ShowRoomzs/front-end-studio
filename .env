VITE_API_URL = https://api.showroomz.shop

# 소셜 로그인 — 각 provider 훅 주석에 콘솔 등록 절차가 있다.
#   카카오: src/features/auth/hooks/useKakaoLogin.ts
#   네이버: src/features/auth/hooks/useNaverLogin.ts
#   구글:   src/features/auth/hooks/useGoogleLogin.ts
#   Apple:  src/features/auth/hooks/useAppleLogin.ts
# 값이 비어 있으면 로그인 버튼 클릭 시 "OOO 로그인이 아직 설정되지 않았습니다" 에러가 뜬다(정상).
#
# ⚠️ 카카오만 JavaScript 키가 아니라 REST API 키를 쓴다.
#    JS SDK의 Kakao.Auth.login()이 v2에서 제거돼 authorize URL을 직접 열기 때문.
#    code→token 교환은 Vercel 서버리스 함수(api/kakao-token.ts)가 담당하며,
#    그쪽 환경변수(KAKAO_REST_API_KEY 등)는 Vercel 대시보드에 VITE_ 없이 따로 등록해야 한다.
VITE_KAKAO_REST_API_KEY=d96d2c51e38d6f756b7a61eb9032b924
VITE_KAKAO_REDIRECT_URI=https://front-end-studio-one.vercel.app/oauth/kakao/callback
VITE_NAVER_CLIENT_ID=9IfW_90DtvnijGqKRl6P
VITE_NAVER_REDIRECT_URI=https://front-end-studio-one.vercel.app/oauth/naver/callback
VITE_GOOGLE_CLIENT_ID=495703171100-5d5qh4t527v7a6rqbjdufsvn9dropc3q.apps.googleusercontent.com
# Apple은 Return URL이 HTTPS만 허용된다 — 로컬 테스트는 ngrok 등 HTTPS 터널 필요.
VITE_APPLE_CLIENT_ID=
VITE_APPLE_REDIRECT_URI=
